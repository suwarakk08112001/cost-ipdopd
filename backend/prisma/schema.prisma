model RcptPrintDetail {
  financeNumber   String  @map("finance_number") @db.VarChar(7)
  rcpno           String? @db.VarChar(20)
  vn              String? @db.VarChar(13)
  income          String  @db.Char(2)
  paidst          String  @db.Char(2)
  rcptamt         Float?  @db.Double
  discount        Float?  @db.Double
  totalAmount     Float?  @map("total_amount") @db.Double
  hosGuid         String? @map("hos_guid") @db.VarChar(38)
  hosGuidExt      String? @map("hos_guid_ext") @db.VarChar(64)
  specialDiscount Float?  @map("special_discount") @db.Double

  ovst      Ovst?      @relation("OvstToRcptPrintDetail", fields: [vn], references: [vn], onDelete: NoAction, onUpdate: NoAction)
  rcptPrint RcptPrint? @relation("RcptPrintToDetail", fields: [rcpno], references: [rcpno], onDelete: NoAction, onUpdate: NoAction)

  @@id([financeNumber, income, paidst])
  @@index([financeNumber], map: "finance_number")
  @@index([income], map: "income")
  @@index([rcpno], map: "rcpno")
  @@index([vn], map: "vn")
  @@index([financeNumber, income], map: "ix_fn_income")
  @@index([hosGuid], map: "ix_hos_guid")
  @@index([hosGuidExt], map: "ix_hos_guid_ext")
  @@map("rcpt_print_detail")
}

