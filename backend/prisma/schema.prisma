// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


model Ovst {
  hosGuid            String    @id @map("hos_guid") @db.VarChar(38)
  vn                 String?   @unique(map: "ix_vn_unique") @db.VarChar(13)
  hn                 String?   @db.VarChar(9)
  an                 String?   @db.VarChar(9)
  vstdate            DateTime? @db.Date
  vsttime            DateTime? @db.Time(0)
  doctor             String?   @db.VarChar(7)
  hospmain           String?   @db.VarChar(9)
  hospsub            String?   @db.VarChar(9)
  oqueue             Int?
  ovstist            String?   @db.Char(2)
  ovstost            String?   @db.VarChar(4)
  pttype             String?   @db.Char(2)
  pttypeno           String?   @db.VarChar(50)
  rfrics             String?   @db.Char(1)
  rfrilct            String?   @db.VarChar(9)
  rfrocs             String?   @db.Char(1)
  rfrolct            String?   @db.VarChar(9)
  spclty             String?   @db.Char(2)
  rcptDisease        String?   @map("rcpt_disease") @db.VarChar(100)
  hcode              String?   @db.VarChar(5)
  curDep             String?   @map("cur_dep") @db.Char(3)
  curDepBusy         String?   @map("cur_dep_busy") @db.Char(1)
  lastDep            String?   @map("last_dep") @db.Char(3)
  curDepTime         DateTime? @map("cur_dep_time") @db.Time(0)
  rxQueue            Int?      @map("rx_queue")
  diagText           String?   @map("diag_text") @db.VarChar(250)
  ptSubtype          Int?      @map("pt_subtype") @db.TinyInt
  mainDep            String?   @map("main_dep") @db.Char(3)
  mainDepQueue       Int?      @map("main_dep_queue")
  financeSummaryDate DateTime? @map("finance_summary_date") @db.Date
  visitType          String?   @map("visit_type") @db.Char(1)
  nodeId             String?   @map("node_id") @db.Char(1)
  contractId         Int?      @map("contract_id")
  waiting            String?   @db.Char(1)
  rfriIcd10          String?   @map("rfri_icd10") @db.VarChar(6)
  oReferNumber       Int?      @map("o_refer_number")
  hasInsurance       String?   @map("has_insurance") @db.Char(1)
  iReferNumber       String?   @map("i_refer_number") @db.VarChar(25)
  referType          String?   @map("refer_type") @db.Char(1)
  oReferDep          String?   @map("o_refer_dep") @db.VarChar(5)
  staff              String?   @db.VarChar(25)
  commandDoctor      String?   @map("command_doctor") @db.VarChar(6)
  sendPerson         String?   @map("send_person") @db.VarChar(150)
  ptPriority         Int?      @map("pt_priority")
  financeLock        String?   @map("finance_lock") @db.Char(1)
  oldcode            String?   @db.VarChar(20)
  signDoctor         String?   @map("sign_doctor") @db.VarChar(10)
  anonymousVisit     String?   @map("anonymous_visit") @db.Char(1)
  anonymousVn        String?   @map("anonymous_vn") @db.VarChar(12)
  ptCapabilityTypeId Int?      @map("pt_capability_type_id")
  atHospital         String?   @map("at_hospital") @db.Char(1)
   ovstKey            String?   @map("ovst_key") @db.VarChar(40)
   vnStat VnStat? @relation("OvstVnStat", fields: [vn], references: [vn], onDelete: NoAction, onUpdate: NoAction)
  department Kskdepartment? @relation("OvstMainDep", fields: [mainDep], references: [depcode], onDelete: NoAction, onUpdate: NoAction)
    rcptPrintDetails RcptPrintDetail[] @relation("OvstToRcptPrintDetail")
     
  ptType             Pttype?   @relation("OvstToPttype", fields: [pttype], references: [pttype], onDelete: NoAction, onUpdate: NoAction)
  @@index([an], map: "ix_an")
  @@index([doctor], map: "ix_doctor")
  @@index([hcode], map: "ix_hcode")
  @@index([hn], map: "ix_hn")
  @@index([hn, vstdate], map: "ix_hn_vstdate")
  @@index([oReferNumber], map: "ix_o_refer_number")
  @@index([pttype], map: "ix_pttype")
  @@index([spclty], map: "ix_spclty")
  @@index([staff], map: "ix_staff")
  @@index([vstdate], map: "ix_vstdate")
  @@index([iReferNumber], map: "ix_i_refer_number")
  @@index([anonymousVn], map: "ix_anonymous_vn")
  @@index([vn, anonymousVisit, anonymousVn], map: "ix_vn_anonymous_vs_vn")
  @@index([vn, vstdate], map: "ix_vn_date")
  @@index([vstdate, curDep], map: "ix_vstdate_curdep")
  @@index([anonymousVisit, anonymousVn, vn], map: "ix_vn_anonymous_vs_vn_index")
  @@map("ovst")
}

