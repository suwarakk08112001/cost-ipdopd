  showNhsoFeeSchedule                                                        String? @map("show_nhso_fee_schedule") @db.Char(1)
  showNhsoConfirmService                                                      String? @map("show_nhso_confirm_service") @db.Char(1)
  claimNhsoFs104                                                               String? @map("claim_nhso_fs_104") @db.Char(1)
  sendMophDental                                                                String? @map("send_moph_dental") @db.Char(1)
