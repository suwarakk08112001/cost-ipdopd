  billDateTime          DateTime? @map("bill_date_time")
  user                  String?   @db.VarChar(15)
  hn                    String?   @db.VarChar(9)
  vn                    String?   @db.VarChar(13)
  status                String?   @db.VarChar(5)
  department            String?   @db.Char(3)
  pttype                String?   @db.Char(2)
  remainMoney           Float?    @map("remain_money") @db.Double
  computer              String?   @db.VarChar(25)
  creditCard            String?   @map("credit_card") @db.Char(1)
  discount              Float?    @db.Double
  bookNumber            Int?      @map("book_number")
  billNumber            Int?      @map("bill_number")
  accountConfirm        String?   @map("account_confirm") @db.Char(1)
  totalAmount           Float?    @map("total_amount") @db.Double
  manualDiscount        Float?    @map("manual_discount") @db.Double
  financePayTypeId      Int?      @map("finance_pay_type_id")
  creditCardAmount      Float?    @map("credit_card_amount") @db.Double
  creditCardId          Int?      @map("credit_card_id")
  creditCardNo          String?   @map("credit_card_no") @db.VarChar(50)
  creditCardOwner       String?   @map("credit_card_owner") @db.VarChar(200)
  hosGuid               String?   @map("hos_guid") @db.VarChar(38)
  creditTransfer        String?   @map("credit_transfer") @db.Char(1)
  hosGuidExt            String?   @map("hos_guid_ext") @db.VarChar(64)
  billDate              DateTime? @map("bill_date") @db.Date
  billStaff             String?   @map("bill_staff") @db.VarChar(50)
  cashAmount            Float?    @map("cash_amount") @db.Double
  depositDebitAmount    Float?    @map("deposit_debit_amount") @db.Double
  receiveCashAmount     Float?    @map("receive_cash_amount") @db.Double
  moneyTransmit         String?   @map("money_transmit") @db.Char(1)
  officerId             Int?      @map("officer_id")
  rcptPrintTransHeadId  Int?      @map("rcpt_print_trans_head_id")
  billTime              DateTime? @map("bill_time") @db.Time(0)
  couponAmount          Float?    @map("coupon_amount") @db.Double
  couponNo              String?   @map("coupon_no") @db.VarChar(50)
  specialDiscountAmount Float?    @map("special_discount_amount") @db.Double
  kioskPay              String?   @map("kiosk_pay") @db.Char(1)
  kioskRefNo            String?   @map("kiosk_ref_no") @db.VarChar(50)
  changeMoney           Float?    @map("change_money") @db.Double
  hospitalDepartmentId  Int?      @map("hospital_department_id")
  qrAmount              Float?    @map("qr_amount") @db.Double
  qrRefCode             String?   @map("qr_ref_code") @db.VarChar(200)
  rcptDepositTypeId     Int?      @map("rcpt_deposit_type_id")
  ktbHwAmount           Float?    @map("ktb_hw_amount") @db.Double

  details RcptPrintDetail[] @relation("RcptPrintToDetail")

  @@index([hn], map: "hn")
  @@index([vn], map: "vn")
  @@index([bookNumber], map: "ix_booknumber")
  @@index([billNumber], map: "ix_billnumber")
  @@index([pttype], map: "ix_pttype")
  @@index([billDateTime], map: "ix_bill_date_time")
  @@index([hosGuid], map: "ix_hos_guid")
  @@index([user, billDateTime], map: "ix_user_bill_datetime")
  @@index([hosGuidExt], map: "ix_hos_guid_ext")
  @@index([billDate], map: "ix_bill_date")
  @@index([rcptPrintTransHeadId], map: "ix_trans_id")
  @@index([billDateTime, user], map: "ix_user_bill_datetime_index")
